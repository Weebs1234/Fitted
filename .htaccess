# getfitted.nl on Strato (Apache). Short, permanent download links that always point to the newest release
# on GitHub, e.g. https://getfitted.nl/download/windows
Redirect 302 /download/windows https://github.com/Weebs1234/Fitted/releases/latest/download/Fitted.exe
Redirect 302 /download/mac-apple-silicon https://github.com/Weebs1234/Fitted/releases/latest/download/Fitted-mac-apple-silicon.dmg
Redirect 302 /download/mac-intel https://github.com/Weebs1234/Fitted/releases/latest/download/Fitted-mac-intel.dmg
Redirect 302 /download/android https://github.com/Weebs1234/Fitted/releases/latest/download/Fitted-android.apk

# Once getfitted.nl has its SSL certificate, remove the # from the next three lines to always use https
#RewriteEngine On
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
